        .vuln-table td {
            padding: 11px 16px;
            border-bottom: 1px solid var(--text-muted);
            color: var(--text-secondary);
            vertical-align: top;
        }

        .vuln-table tr:last-child td { border-bottom: none; }
        .vuln-table tr:nth-child(even) td { background: var(--accent-dim2); }

        .vuln-table td.vuln-name {
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--red);
            font-weight: 500;
            white-space: nowrap;
