        code.output   { color: var(--blue); }
        code.pass     { color: var(--green); }
        code.fail     { color: var(--red); }
        code.comment  { color: var(--text-muted); font-style: italic; }

        /* ── SCAN RESULTS TABLE ── */
        .results-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 24px 0;
