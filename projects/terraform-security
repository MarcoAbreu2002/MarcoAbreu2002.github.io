        .result-card.before { border-top: 3px solid var(--red); }
        .result-card.after  { border-top: 3px solid var(--green); }

        .result-card .label {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .result-card .stat {
            display: flex;
            justify-content: space-around;
            gap: 12px;
        }

        .result-card .stat-item { text-align: center; }

        .result-card .stat-item .num {
            font-family: var(--font-mono);
            font-size: 2.4rem;
            font-weight: 600;
            line-height: 1;
        }

        .result-card .stat-item .num.pass { color: var(--green); }
        .result-card .stat-item .num.fail { color: var(--red); }

        .result-card .stat-item .desc {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 4px;
            font-family: var(--font-mono);
        }

        /* ── VULN TABLE ── */
        .vuln-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 0.88rem;
